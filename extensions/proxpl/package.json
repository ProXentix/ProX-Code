{
  "name": "proxpl",
  "displayName": "ProXPL Language Support",
  "description": "Syntax highlighting and language support for the ProXPL programming language",
  "version": "1.6.2",
  "publisher": "ProXentix",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ProXentix/ProX-Code.git"
  },
  "main": "./out/extension.js",
  "engines": {
    "proxCode": "^1.0.0"
  },
  "icon": "logo.png",
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^18.19.130",
    "@types/vscode": "^1.110.0",
    "@typescript-eslint/eslint-plugin": "^8.57.2",
    "@typescript-eslint/parser": "^8.57.2",
    "esbuild": "^0.28.1",
    "eslint": "^10.1.0",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.2"
  },
  "dependencies": {
    "vscode-languageclient": "^10.1.0"
  },
  "activationEvents": [
    "onLanguage:proxpl",
    "onView:proxpl.runView.main",
    "onCommand:proxpl.run",
    "onCommand:proxpl.build",
    "onCommand:proxpl.debug",
    "workspaceContains:project.pxcf"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "workbench.view.proxpl.run",
          "title": "ProXPL",
          "icon": "$(play)"
        }
      ]
    },
    "views": {
      "workbench.view.proxpl.run": [
        {
          "type": "webview",
          "id": "proxpl.runView.main",
          "name": "Project Settings"
        }
      ]
    },
    "languages": [
      {
        "id": "proxpl",
        "aliases": [
          "ProXPL",
          "prox"
        ],
        "extensions": [
          ".prox",
          ".pxpl"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "proxpl",
        "scopeName": "source.proxpl",
        "path": "./syntaxes/proxpl.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "proxpl",
        "path": "./snippets/proxpl-snippets.json"
      }
    ],
    "commands": [
      {
        "command": "proxpl.run",
        "title": "ProXPL: Run File",
        "icon": "$(play)"
      },
      {
        "command": "proxpl.build",
        "title": "ProXPL: Build",
        "icon": "$(package)"
      },
      {
        "command": "proxpl.debug",
        "title": "ProXPL: Debug",
        "icon": "$(bug)"
      },
      {
        "command": "proxpl.startWatchMode",
        "title": "ProXPL: Toggle Watch Mode",
        "icon": "$(eye)"
      },
      {
        "command": "proxpl.format",
        "title": "Format ProXPL"
      },
      {
        "command": "proxpl.checkSyntax",
        "title": "Check Syntax"
      },
      {
        "command": "proxpl.analyzeCode",
        "title": "Analyze Code"
      },
      {
        "command": "proxpl.compile",
        "title": "Compile Current File"
      },
      {
        "command": "proxpl.generateBytecode",
        "title": "Generate Bytecode"
      },
      {
        "command": "proxpl.inspectAST",
        "title": "Inspect AST"
      },
      {
        "command": "proxpl.inspectBytecode",
        "title": "Inspect Bytecode"
      },
      {
        "command": "proxpl.generateDoc",
        "title": "Generate Documentation"
      },
      {
        "command": "proxpl.langServerStatus",
        "title": "Language Server Status"
      }
    ],
    "submenus": [
      {
        "id": "proxpl.submenu",
        "label": "ProXPL"
      }
    ],
    "keybindings": [
      {
        "command": "proxpl.run",
        "key": "ctrl+f5",
        "mac": "cmd+f5",
        "when": "editorTextFocus && resourceLangId == proxpl"
      },
      {
        "command": "proxpl.build",
        "key": "ctrl+shift+b",
        "mac": "cmd+shift+b",
        "when": "editorTextFocus && resourceLangId == proxpl"
      },
      {
        "command": "proxpl.debug",
        "key": "f5",
        "mac": "f5",
        "when": "editorTextFocus && resourceLangId == proxpl"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "when": "resourceExtname == .prox || resourceExtname == .pxpl",
          "command": "proxpl.run",
          "group": "navigation@1"
        },
        {
          "when": "resourceExtname == .prox || resourceExtname == .pxpl",
          "command": "proxpl.build",
          "group": "navigation@2"
        },
        {
          "when": "resourceExtname == .prox || resourceExtname == .pxpl",
          "command": "proxpl.debug",
          "group": "navigation@3"
        }
      ],
      "explorer/context": [
        {
          "when": "resourceExtname == .prox || resourceExtname == .pxpl",
          "command": "proxpl.run",
          "group": "navigation@1"
        },
        {
          "when": "resourceExtname == .prox || resourceExtname == .pxpl",
          "command": "proxpl.build",
          "group": "navigation@2"
        },
        {
          "when": "resourceExtname == .prox || resourceExtname == .pxpl",
          "command": "proxpl.debug",
          "group": "navigation@3"
        }
      ],
      "editor/context": [
        {
          "submenu": "proxpl.submenu",
          "group": "z_proxpl",
          "when": "resourceExtname == .prox || resourceExtname == .pxpl"
        }
      ],
      "proxpl.submenu": [
        {
          "command": "proxpl.format",
          "group": "1_edit"
        },
        {
          "command": "proxpl.checkSyntax",
          "group": "2_analyze"
        },
        {
          "command": "proxpl.analyzeCode",
          "group": "2_analyze"
        },
        {
          "command": "proxpl.compile",
          "group": "3_build"
        },
        {
          "command": "proxpl.generateBytecode",
          "group": "3_build"
        },
        {
          "command": "proxpl.inspectAST",
          "group": "4_inspect"
        },
        {
          "command": "proxpl.inspectBytecode",
          "group": "4_inspect"
        },
        {
          "command": "proxpl.generateDoc",
          "group": "5_doc"
        },
        {
          "command": "proxpl.langServerStatus",
          "group": "6_status"
        }
      ]
    },
    "debuggers": [
      {
        "type": "proxpl",
        "label": "ProXPL Debug",
        "program": "./out/extension.js",
        "runtime": "node",
        "languages": [
          "proxpl"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [
              "program"
            ],
            "properties": {
              "program": {
                "type": "string",
                "description": "Absolute path to a text file.",
                "default": "${workspaceFolder}/${command:AskForProgramName}"
              },
              "stopOnEntry": {
                "type": "boolean",
                "description": "Automatically stop after launch.",
                "default": true
              },
              "trace": {
                "type": "boolean",
                "description": "Enable logging of the Debug Adapter Protocol.",
                "default": true
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "proxpl",
            "request": "launch",
            "name": "Ask for file name",
            "program": "${workspaceFolder}/${command:AskForProgramName}",
            "stopOnEntry": true
          }
        ]
      }
    ]
  },
  "keywords": [
    "proxpl",
    "prox",
    "programming language",
    "compiler",
    "interpreter",
    "vm",
    "system programming",
    "language server",
    "syntax highlighting",
    "snippets",
    "prm",
    "package manager"
  ],
  "author": "Kanishk Raj <programmerkr.123@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/ProgrammerKR/ProXPL/issues"
  },
  "homepage": "https://github.com/ProgrammerKR/ProXPL#readme",
  "overrides": {
    "minimatch": "^9.0.0",
    "brace-expansion": "^5.0.9"
  }
}
